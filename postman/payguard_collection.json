        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchant\": \"aws.amazon.com\",\n  \"amount\": 45.00,\n  \"description\": \"Pay monthly AWS server bill\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/evaluate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "evaluate"]
        }
      },
      "response": []
    },
    {
      "name": "Evaluate Risk (Flagged Fraud Merchant)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchant\": \"free-crypto-store.xyz\",\n  \"amount\": 500.00,\n  \"description\": \"Claim free crypto giftcard\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/evaluate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "evaluate"]
        }
      },
      "response": []
    },
    {
