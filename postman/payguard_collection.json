      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"intent\": \"Pay monthly AWS server bill\",\n  \"merchant\": \"aws.amazon.com\",\n  \"amount\": 45.00,\n  \"currency\": \"USD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transact",
          "host": ["{{baseUrl}}"],
